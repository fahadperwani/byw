{
  "kind": "collectionType",
  "collectionName": "meals",
  "info": {
    "singularName": "meal",
    "pluralName": "meals",
    "displayName": "Meal"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "menus": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::menu.menu",
      "mappedBy": "meal"
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::menu-item.menu-item",
      "mappedBy": "section"
    },
    "wedding": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::wedding.wedding",
      "inversedBy": "mealSection"
    },
    "foodScheduled": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::note.note"
    }
  }
}
