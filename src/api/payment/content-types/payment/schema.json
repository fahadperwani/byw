{
  "kind": "collectionType",
  "collectionName": "payments",
  "info": {
    "singularName": "payment",
    "pluralName": "payments",
    "displayName": "Payment"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "payment"
    },
    "expiry": {
      "type": "datetime"
    },
    "googleToken": {
      "type": "string",
      "unique": true
    },
    "appleId": {
      "type": "string",
      "unique": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "com.bridalyourway.mobile.staging.lifetime",
        "com.bridalyourway.mobile.staging.monthly"
      ]
    },
    "start": {
      "type": "datetime"
    }
  }
}
