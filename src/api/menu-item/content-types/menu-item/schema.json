{
  "kind": "collectionType",
  "collectionName": "menu_items",
  "info": {
    "singularName": "menu-item",
    "pluralName": "menu-items",
    "displayName": "Menu Item",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "serving": {
      "type": "integer"
    },
    "isPurchased": {
      "type": "boolean",
      "default": false
    },
    "menu": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::menu.menu",
      "inversedBy": "items"
    },
    "section": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::meal.meal",
      "inversedBy": "items"
    },
    "person": {
      "type": "string"
    }
  }
}
